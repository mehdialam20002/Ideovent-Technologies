# ─────────────────────────────────────────────────────────────
# Ideovent Technologies — environment variables
# Copy this file to `.env` and fill in what you need.
# The site works with ZERO config (local mode). Add Supabase to go fully live.
# ─────────────────────────────────────────────────────────────

# Supabase (optional) — enables LIVE global mode: real database, admin auth,
# image uploads to CDN, and instant certificate verification for everyone.
# Get these from your Supabase project → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin passcode for LOCAL mode (used only when Supabase is NOT configured).
VITE_ADMIN_PASSCODE=ideovent2026

# Public origin used for certificate QR codes / verify links.
# Defaults to the current browser origin if left blank.
VITE_PUBLIC_URL=https://ideovent.com

# EmailJS (optional) — delivers contact-form messages to your inbox.
# Leads are always saved in the admin regardless; this just also emails you.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
